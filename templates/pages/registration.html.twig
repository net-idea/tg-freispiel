{% extends 'base.html.twig' %}

{% block title %}
  Anmeldung - Theatergruppe Freispiel
{% endblock %}

{% block body %}
  <div class="row justify-content-center">
    <div class="col-lg-8">
      {# Page Header #}
      <div class="text-center mb-5">
        <h1 class="display-4 hero-title">🎭 Anmeldung zur Probestunde</h1>
        {% if nextDate %}
          <p class="hero-lead mt-3">
            Nächste Probestunde: <strong><time datetime="{{ nextDate.startsAt|date('Y-m-d\\TH:i') }}">{{ nextDate.formatGerman }}</time></strong>
          </p>
        {% endif %}
      </div>

      {# Server-rendered status (non-JS fallback); the Stimulus controller renders these inline for Ajax #}
      {% if result is not null %}
        {% if result.shouldPresentAsSuccess %}
          <div class="alert alert-success mb-4" role="alert" id="registration-success">
            {{ messages.success }}
          </div>
        {% elseif result.status.value == 'rate_limited' %}
          <div class="alert alert-danger mb-4" role="alert" id="registration-error">
            {{ messages.rate }}
          </div>
        {% elseif result.status.value == 'mail_error' %}
          <div class="alert alert-danger mb-4" role="alert" id="registration-error">
            {{ messages.mail }}
          </div>
        {% elseif form.vars.submitted and not form.vars.valid %}
          <div class="alert alert-danger mb-4" role="alert" id="registration-error">
            <p class="mb-2">
              {{ messages.invalid }}
            </p>
            <ul class="mb-0">
              {% for child in form.children %}
                {% for errorItem in child.vars.errors %}
                  <li><strong>{{ child.vars.label }}:</strong> {{ errorItem.message }}</li>
                {% endfor %}
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      {% endif %}

      {# Registration Form Card #}
      <div class="card shadow-lg" data-controller="ajax-form">
        <div class="card-header card-header-accent p-4">
          <h2 class="h4 mb-0 fw-bold">✍️ Melde dich zur Probestunde an</h2>
        </div>
        <div class="card-body p-4 p-md-5">
          <p class="lead mb-4">
            Bei uns ist jede und jeder herzlich willkommen! Damit wir uns bei der Probestunde richtig Zeit für dich nehmen können, bitten wir dich nur um eine kurze Anmeldung vorab. Trag dich einfach ein – ganz unverbindlich. Wir freuen uns auf dich!
          </p>

          <div data-ajax-form-target="alert"></div>

          {{ form_start(form, { action: path('app_registration'), attr: { class: 'vstack gap-2', novalidate: 'novalidate', 'data-ajax-form-target': 'form', 'data-action': 'submit->ajax-form#submit' } }) }}

          {% for field in [form.name, form.email, form.phone] %}
            <div class="mb-4">
              {{ form_label(field) }}
              {{ form_widget(field, { attr: { class: (field.vars.errors|length) > 0 ? 'form-control form-control-lg is-invalid' : 'form-control form-control-lg' } }) }}
              {% for errorItem in field.vars.errors %}
                <div class="invalid-feedback d-block">
                  {{ errorItem.message }}
                </div>
              {% endfor %}
            </div>
          {% endfor %}

          <h3 class="h5 fw-bold mt-2 mb-3">Drei Fragen an dich</h3>

          <div class="mb-4">
            {{ form_label(form.motivation) }}
            {{ form_widget(form.motivation, { attr: { class: (form.motivation.vars.errors|length) > 0 ? 'form-control is-invalid' : 'form-control' } }) }}
            {% for errorItem in form.motivation.vars.errors %}
              <div class="invalid-feedback d-block">
                {{ errorItem.message }}
              </div>
            {% endfor %}
          </div>

          {# Role checkboxes + reason #}
          <div class="mb-4">
            {{ form_label(form.roleTypes) }}
            <div class="d-flex flex-wrap gap-3 mt-1">
              {% for choice in form.roleTypes %}
                <div class="form-check form-check-inline me-0">
                  {{ form_widget(choice) }}
                  {{ form_label(choice, null, { label_attr: { class: 'form-check-label' } }) }}
                </div>
              {% endfor %}
            </div>
            {% for errorItem in form.roleTypes.vars.errors %}
              <div class="invalid-feedback d-block">
                {{ errorItem.message }}
              </div>
            {% endfor %}
          </div>

          <div class="mb-4">
            {{ form_label(form.roleReason) }}
            {{ form_widget(form.roleReason, { attr: { class: (form.roleReason.vars.errors|length) > 0 ? 'form-control is-invalid' : 'form-control' } }) }}
            {% for errorItem in form.roleReason.vars.errors %}
              <div class="invalid-feedback d-block">
                {{ errorItem.message }}
              </div>
            {% endfor %}
          </div>

          <div class="mb-4">
            {{ form_label(form.expectations) }}
            {{ form_widget(form.expectations, { attr: { class: (form.expectations.vars.errors|length) > 0 ? 'form-control is-invalid' : 'form-control' } }) }}
            {% for errorItem in form.expectations.vars.errors %}
              <div class="invalid-feedback d-block">
                {{ errorItem.message }}
              </div>
            {% endfor %}
          </div>

          <div class="honeypot" aria-hidden="true">
            {{ form_row(form.website) }}
            {{ form_row(form.emailrep) }}
          </div>

          <div class="form-check mb-2">
            {{ form_widget(form.consent, { attr: { class: (form.consent.vars.errors|length) > 0 ? 'form-check-input is-invalid' : 'form-check-input' } }) }}
            <label class="form-check-label" for="{{ form.consent.vars.id }}">Ich willige in die Verarbeitung meiner Angaben zum Zweck der Anmeldung ein (<a href="/datenschutz" target="_blank" rel="noopener">Datenschutzerklärung</a>).</label>
            {% for errorItem in form.consent.vars.errors %}
              <div class="invalid-feedback d-block">
                {{ errorItem.message }}
              </div>
            {% endfor %}
          </div>

          <div class="form-check mb-4">
            {{ form_widget(form.copy, { attr: { class: 'form-check-input' } }) }}
            {{ form_label(form.copy, null, { label_attr: { class: 'form-check-label' } }) }}
          </div>

          <div class="d-grid">
            <button type="submit" class="btn btn-primary btn-lg py-3 fw-bold fs-5" data-ajax-form-target="submit">Anmelden</button>
          </div>

          {# Fine print #}
          <p class="text-body-secondary small mt-3 mb-0">
            Mitmachen kannst du ab 16 Jahren – wenn du noch nicht volljährig bist, brauchen wir die Einwilligung der Eltern. Wie wir mit deinen Daten umgehen, erfährst du in unserer <a href="/datenschutz">Datenschutzerklärung</a>.
          </p>

          {{ form_rest(form) }}
          {{ form_end(form) }}
        </div>
      </div>
    </div>
  </div>
{% endblock %}
