{% extends 'base.html.twig' %}

{% block title %}
  Termine - Theatergruppe Freispiel
{% endblock %}

{% block body %}
  <div class="row justify-content-center">
    <div class="col-lg-8">
      {# Page Header #}
      <div class="text-center mb-5">
        <h1 class="display-4 hero-title">📅 Termine</h1>
      </div>

      {# Upcoming dates #}
      {% if (dates|length) > 0 %}
        {% for date in dates %}
          <div class="card shadow-lg mb-4">
            <div class="card-body p-4 p-md-5">
              <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-2">
                <h2 class="h4 section-title mb-0">{{ date.title }}</h2>
                <p class="h5 mb-0">
                  {% if date.startsAt %}
                    <time datetime="{{ date.startsAt|date('Y-m-d\\TH:i') }}">{{ date.formatGerman }}</time>
                  {% else %}
                    {{ date.formatGerman }}
                  {% endif %}
                </p>
              </div>
              {% if date.description %}
                <p class="card-text mb-0">
                  {{ date.description }}
                </p>
              {% endif %}
              {% if date.startsAt %}
                <p class="mb-0 mt-3">
                  <a href="{{ path('app_registration') }}" class="footer-gold-link">→ Zur Anmeldung</a>
                </p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div class="card shadow-lg mb-4">
          <div class="card-body p-4 p-md-5 text-center">
            <p class="card-text mb-0">
              Aktuell stehen keine Termine an – schau bald wieder vorbei!
            </p>
          </div>
        </div>
      {% endif %}

      {# Call to action → Anmeldung #}
      <div class="card card-cta shadow-lg mt-5">
        <div class="card-body p-4 p-md-5 text-center">
          <h2 class="card-title h3 mb-4">🎭 Lust bekommen?</h2>
          <p class="card-text fs-5 mb-4">
            Melde dich zur Probestunde an und schnupper völlig unverbindlich rein.
          </p>
          <a href="{{ path('app_registration') }}" class="btn btn-primary btn-lg px-5 py-3 fw-bold fs-5">Zur Anmeldung</a>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
