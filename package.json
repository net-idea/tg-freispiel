{
  "name": "theatergruppe-freispiel",
  "description": "Website for the theater group 'Theatergruppe Freispiel' in Dormagen",
  "license": "MIT",
  "private": true,
  "author": "Adam Ibrom <adam@net-i.de>",
  "contributors": [
    "Adam Ibrom <adam@net-i.de>"
  ],
  "scripts": {
    "start": "bash ./develop.sh",
    "dev-server": "encore dev-server",
    "dev": "encore dev",
    "watch": "encore dev --watch",
    "build": "encore production --progress",
    "deploy": "bash ./deploy.sh",
    "tsc:check": "tsc --noEmit",
    "tsc:watch": "tsc --noEmit -w",
    "lint:css": "stylelint 'assets/**/*.{css,scss}'",
    "lint:css:fix": "stylelint 'assets/**/*.{css,scss}' --fix",
    "og:build": "node og.js",
    "lint:html": "prettier \"templates/**/*.html.twig\" --check",
    "lint:html:fix": "prettier \"templates/**/*.html.twig\" --write",
    "lint:twig": "php bin/console lint:twig templates",
    "lint": "yarn run lint:css:fix && yarn run tsc:check && yarn run lint:twig && yarn run lint:html",
    "lint:fix": "yarn run lint:css:fix && yarn run lint:html:fix && yarn run lint:twig"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.0",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^8.0.12",
    "@symfony/stimulus-bridge": "^4.0.1",
    "@symfony/ux-turbo": "^2.36.2",
    "@symfony/webpack-encore": "^7.1.0",
    "core-js": "^3.39.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@popperjs/core": "^2.11.8",
    "@zackad/prettier-plugin-twig": "^0.17.0",
    "babel-loader": "^10.0.0",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "bootstrap": "^5.3.3",
    "file-loader": "^6.2.0",
    "fork-ts-checker-webpack-plugin": "^9.0.2",
    "postcss": "^8.5.17",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.5",
    "sass": "^1.96.0",
    "sass-loader": "^17.0.0",
    "sharp": "^0.35.3",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.2.0",
    "ts-loader": "^9.5.1",
    "typescript": "^6.0.0",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^5.2.6"
  }
}
